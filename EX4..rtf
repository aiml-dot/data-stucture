#include<iostream>\par
#include<string>\par
using namespace std;\par
\par
struct Node\par
\{\par
\tab string teamName;\par
\tab Node *next;\par
\tab\par
\};\par
\par
class CircularLinkedList\par
\{\par
\tab private:\par
\tab\tab Node *last;\par
\tab\tab\par
\tab public:\par
\tab\tab CircularLinkedList()\par
\tab\tab\{\par
\tab\tab\tab last = NULL;\par
\par
\tab\tab\}\par
\tab     void addTeam(string name)\par
\tab     \{\par
\tab     \tab Node *newNode = new Node;\par
\tab         newNode->teamName = name;\par
\par
\tab     \tab\par
\tab     \tab if (last == NULL)\par
\par
\tab     \{\par
\tab         last = newNode;\par
\tab         newNode->next = newNode;\par
\par
\tab\tab\}\par
\tab\tab else\par
\tab\tab\{\par
\tab\tab\tab newNode->next = last->next;\par
\tab\tab\tab last->next = newNode;\par
\tab\tab\tab last = newNode;\par
\tab\tab\tab\par
\tab\tab\}\par
\tab    \}\par
\tab    void displayrteams()\par
\tab    \{\par
\tab    \tab\par
\tab    \tab     if (last == NULL)\par
\par
\tab    \tab\par
\tab    \tab\{\par
            cout << "No teams available." << endl;\par
            return;\par
\par
\tab\tab    \}\par
\tab\tab    \par
\par
        Node *temp = last->next;\par
\par
        cout << "\\nTournament Teams:" << endl;\par
\par
        do\par
        \{\par
            cout << temp->teamName << " -> ";\par
            temp = temp->next;\par
        \}\par
        while (temp != last->next);\par
\par
        cout << "(Back to " << last->next->teamName << ")" << endl;\par
    \}\par
\par
    void roundRobin(int rounds)\par
    \{\par
        if (last == NULL)\par
        \{\par
            cout << "No teams available." << endl;\par
            return;\par
        \}\par
\par
        Node *current = last->next;\par
\par
        cout << "\\n--- Round Robin Scheduling ---" << endl;\par
\par
        for (int i = 1; i <= rounds; i++)\par
        \{\par
            cout << "Round " << i << ": ";\par
            cout << current->teamName << " gets the turn." << endl;\par
\par
            current = current->next;\par
        \}\par
    \}\par
\};\par
\par
int main()\par
\{\par
    CircularLinkedList tournament;\par
\par
    int n, rounds;\par
    string name;\par
\par
    cout << "Enter number of teams: ";\par
    cin >> n;\par
\par
    for (int i = 1; i <= n; i++)\par
    \{\par
        cout << "Enter team " << i << " name: ";\par
        cin >> name;\par
\par
        tournament.addTeam(name);\par
    \}\par
    \par
    \par
    tournament.displayrteams();\par
\par
\par
    cout << "\\nEnter number of rounds: ";\par
    cin >> rounds;\par
    \par
    tournament.roundRobin(rounds);\par
\par
    return 0;\par
\}\par
