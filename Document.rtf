#include <string>\par
using namespace std;\par
\par
struct Song \{\par
    string title;\par
    Song* prev;\par
    Song* next;\par
\par
    Song(string t) \{\par
        title = t;\par
        prev = nullptr;\par
        next = nullptr;\par
    \}\par
\};\par
\par
class Playlist \{\par
private:\par
    Song* head;\par
    Song* tail;\par
    Song* current;\par
\par
public:\par
    Playlist() \{\par
        head = nullptr;\par
        tail = nullptr;\par
        current = nullptr;\par
    \}\par
\par
    // Add a song\par
    void addSong(string title) \{\par
        Song* newSong = new Song(title);\par
\par
        if (head == nullptr) \{\par
            head = tail = current = newSong;\par
        \} else \{\par
            tail->next = newSong;\par
            newSong->prev = tail;\par
            tail = newSong;\par
        \}\par
\par
        cout << "Song added: " << title << endl;\par
    \}\par
\par
    // Move forward\par
    void nextSong() \{\par
        if (current == nullptr) \{\par
            cout << "Playlist is empty.\\n";\par
        \}\par
        else if (current->next == nullptr) \{\par
            cout << "Already at the last song.\\n";\par
        \}\par
        else \{\par
            current = current->next;\par
            cout << "Playing: " << current->title << endl;\par
        \}\par
    \}\par
\par
    // Move backward\par
    void previousSong() \{\par
        if (current == nullptr) \{\par
            cout << "Playlist is empty.\\n";\par
        \}\par
        else if (current->prev == nullptr) \{\par
            cout << "Already at the first song.\\n";\par
        \}\par
        else \{\par
            current = current->prev;\par
            cout << "Playing: " << current->title << endl;\par
        \}\par
    \}\par
\par
    // Display forward\par
    void displayForward() \{\par
        Song* temp = head;\par
\par
        cout << "\\nPlaylist Forward:\\n";\par
\par
        while (temp != nullptr) \{\par
            if (temp == current)\par
                cout << "-> ";\par
\par
            cout << temp->title << endl;\par
            temp = temp->next;\par
        \}\par
    \}\par
\par
    // Display backward\par
    void displayBackward() \{\par
        Song* temp = tail;\par
\par
        cout << "\\nPlaylist Backward:\\n";\par
\par
        while (temp != nullptr) \{\par
            if (temp == current)\par
                cout << "-> ";\par
\par
            cout << temp->title << endl;\par
            temp = temp->prev;\par
        \}\par
    \}\par
\par
    // Show current song\par
    void showCurrent() \{\par
        if (current == nullptr)\par
            cout << "No song is currently playing.\\n";\par
        else\par
            cout << "Currently playing: " << current->title << endl;\par
    \}\par
\par
    // Destructor\par
    ~Playlist() \{\par
        Song* temp = head;\par
\par
        while (temp != nullptr) \{\par
            Song* next = temp->next;\par
            delete temp;\par
            temp = next;\par
        \}\par
    \}\par
\};\par
\par
int main() \{\par
    Playlist playlist;\par
\par
    playlist.addSong("Shape of You");\par
    playlist.addSong("Blinding Lights");\par
    playlist.addSong("Believer");\par
    playlist.addSong("Perfect");\par
\par
    playlist.displayForward();\par
\par
    playlist.showCurrent();\par
\par
    playlist.nextSong();\par
    playlist.nextSong();\par
\par
    playlist.previousSong();\par
\par
    playlist.displayForward();\par
    playlist.displayBackward();\par
\par
    return 0;\par
\}\par
